# 0G AI Image Gallery — Environment Variables
# Copy to .env and fill in your values

# NOTE: at last verification the `text-to-image` service type was available on
# 0G MAINNET only — testnet carried no image provider. Run `npm run discover`
# first; if it finds nothing on testnet, use the mainnet endpoints below.

# --- Mainnet (Aristotle) — where image providers live ---
RPC_URL=https://evmrpc.0g.ai
STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai

# --- Testnet (Galileo) — storage works, image providers may not exist ---
# RPC_URL=https://evmrpc-testnet.0g.ai
# STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# Your wallet private key (NEVER commit this)
PRIVATE_KEY=your_private_key_here
